# Скопируй в .env и впиши значения. .env в .gitignore — не попадёт в git.

# --- SETO (стенд эксперимента, python -m seto) ---
# внутренние модели Иннополиса, OpenAI-совместимый эндпоинт
MODELS_BASE_URL=http://10.100.11.205/v1
MODELS_API_KEY=your_models_api_key_here
# где лежат raw/, runs/, cache/ — гигабайты, держи вне облачной папки
SETO_DATA_ROOT=/path/to/seto-data
# только если VPN забирает весь трафик: адрес Wi-Fi-интерфейса
# SETO_BIND_SOURCE_IP=

# --- MVP (scripts/, src/clinic_siting) ---
# ключ SiliconFlow; имя переменной историческое
QWEN_API_KEY=your_qwen_api_key_here
